[global]
    # ── Display ──────────────────────────────────────────────
    monitor          = 0
    follow           = mouse
    width            = 320
    height           = 120
    origin           = top-right
    offset           = 14x14
    scale            = 0
    notification_limit = 5
    gap_size         = 6

    # ── Appearance ───────────────────────────────────────────
    # FFXIV panel style — dark translucent with gold border
    background       = "#0a0c18ee"
    foreground       = "#c8b89a"
    highlight        = "#c8a840"

    frame_color      = "#c8a840"
    frame_width      = 1
    corner_radius    = 4

    separator_color  = "#4a3820"
    separator_height = 1

    # ── Typography ───────────────────────────────────────────
    font             = Cinzel 10
    markup           = full
    format           = "<b>%s</b>\n%b"
    alignment        = left
    vertical_alignment = center
    word_wrap        = yes
    ellipsize        = middle

    show_age_threshold = 60
    icon_position    = left
    min_icon_size    = 24
    max_icon_size    = 40
    icon_path        = /usr/share/icons/Papirus-Dark/16x16/apps

    # ── Timing ───────────────────────────────────────────────
    timeout          = 6

    # ── Behaviour ────────────────────────────────────────────
    stack_duplicates  = true
    hide_duplicate_count = false
    show_indicators  = yes
    indicate_hidden  = yes

    mouse_left_click  = do_action, close_current
    mouse_right_click = close_all

    # ── Progress bar (for volume/brightness OSD) ──────────────
    progress_bar                = true
    progress_bar_height         = 8
    progress_bar_frame_width    = 1
    progress_bar_min_width      = 280
    progress_bar_max_width      = 320
    progress_bar_corner_radius  = 2
    highlight                   = "#c8a840"

    # ── Sound hooks (FFXIV system sounds) ────────────────────
    # Place your .ogg sounds in ~/.config/eww/sounds/
    # Keys: normal message  → chime.ogg
    #       urgent/DM       → dm_received.ogg
    #       low priority    → (silent)

[urgency_low]
    background       = "#080c18dd"
    foreground       = "#7a6a50"
    frame_color      = "#3a2e1a"
    timeout          = 4
    # No sound for low priority

[urgency_normal]
    background       = "#0a0c18ee"
    foreground       = "#c8b89a"
    frame_color      = "#c8a840"
    timeout          = 6
    script           = "mpv --no-terminal --volume=80 ~/.config/eww/sounds/chime.mp3 2>/dev/null"

[urgency_critical]
    background       = "#1a0808ee"
    foreground       = "#f0a0a0"
    frame_color      = "#c84040"
    timeout          = 0
    script           = "mpv --no-terminal --volume=90 ~/.config/eww/sounds/dm_received.mp3 2>/dev/null"

# ── App-specific rules ────────────────────────────────────────

# Discord DMs — gold urgent styling + DM sound
[discord-dm]
    appname          = discord
    summary          = "Direct Message*"
    background       = "#1a1400ee"
    foreground       = "#f0d090"
    frame_color      = "#c8a840"
    script           = "mpv --no-terminal --volume=90 ~/.config/eww/sounds/dm_received.mp3 2>/dev/null"
    timeout          = 10

# Music player — no sound, quiet
[music]
    appname          = audacious
    background       = "#0a0c18cc"
    foreground       = "#8a7050"
    frame_color      = "#4a3820"
    timeout          = 3
