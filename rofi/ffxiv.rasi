/* ══════════════════════════════════════════════════════════════
   FINAL FANTASY XIV — Rofi Theme (Start Menu)
   Save to: ~/.config/rofi/ffxiv.rasi
   ══════════════════════════════════════════════════════════════ */

* {
    /* FFXIV palette */
    gold:           #c8a840;
    gold-bright:    #f0d090;
    gold-dim:       #7a6030;
    gold-border:    rgba(180, 150, 90, 0.40);
    bg-deep:        rgba(6, 9, 20, 0.97);
    bg-hover:       rgba(25, 30, 55, 0.80);
    bg-selected:    rgba(40, 50, 80, 0.90);
    text-main:      #c8b89a;
    text-muted:     #6a5a40;
    text-selected:  #f0d090;

    background-color: transparent;
    text-color:       @text-main;
    font:             "Cinzel 11";
}

window {
    width:            480px;
    background-color: @bg-deep;
    border:           1px solid @gold-border;
    border-radius:    6px;
    padding:          0;
    x-offset:         0;
    y-offset:         0;
    location:         center;
    /* Ornate box shadow */
    box-shadow:       0 0 40px rgba(120, 90, 40, 0.30),
                      inset 0 1px 0 rgba(200, 180, 130, 0.10);
}

mainbox {
    background-color: transparent;
    border:           0;
    padding:          0;
    spacing:          0;
}

/* ── Header / Prompt bar ── */
inputbar {
    background-color: rgba(15, 20, 38, 0.95);
    border-bottom:    1px solid @gold-border;
    padding:          12px 16px;
    spacing:          8px;
    children:         [prompt, textbox-prompt-colon, entry];
}

prompt {
    color:       @gold;
    font:        "Cinzel 10";
    letter-spacing: 2px;
    text-transform: uppercase;
}

textbox-prompt-colon {
    color:  @gold-dim;
    expand: false;
    str:    "  ❯";
}

entry {
    color:            @text-main;
    placeholder:      "Search Main Menu…";
    placeholder-color: @text-muted;
    cursor:           text;
    background-color: transparent;
}

/* ── Results list ── */
listview {
    background-color: transparent;
    padding:          8px 0;
    spacing:          0;
    lines:            10;
    scrollbar:        false;
    fixed-height:     false;
}

element {
    background-color: transparent;
    padding:          8px 16px;
    spacing:          10px;
    border-radius:    0;
    cursor:           pointer;
    orientation:      horizontal;
}

element-icon {
    size:  22px;
    cursor: inherit;
}

element-text {
    color:          @text-main;
    font:           "Cinzel 10";
    vertical-align: 0.5;
    cursor:         inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-selected;
    border-left:      2px solid @gold;
    padding-left:     14px;  /* compensate for border */
}

element selected.normal > element-text {
    color: @text-selected;
}

element.active > element-text {
    color: @gold;
}

element:hover {
    background-color: @bg-hover;
}

/* ── Mode switcher (drun / run / window) ── */
mode-switcher {
    background-color: rgba(10, 14, 28, 0.95);
    border-top:       1px solid @gold-border;
    padding:          6px 12px;
    spacing:          4px;
}

button {
    background-color: transparent;
    color:            @text-muted;
    padding:          4px 10px;
    border-radius:    3px;
    font:             "Cinzel 9";
    letter-spacing:   1px;
    cursor:           pointer;
}

button selected {
    background-color: rgba(40, 50, 80, 0.70);
    color:            @gold;
    border:           1px solid @gold-border;
}

/* ── Message / Error bar ── */
message {
    background-color: rgba(100, 40, 20, 0.30);
    border:           1px solid rgba(180, 80, 40, 0.40);
    padding:          8px 16px;
    border-radius:    3px;
    margin:           4px 8px;
}

textbox {
    color: #e0906060;
    font:  "Cinzel 9";
}
